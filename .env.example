# Server
SERVER_HOST=
SERVER_PORT=8080
# External API (remote key auth): supported, defaults to false. When true the
# API is additionally reachable from any address, authenticated by the API
# key shown in Settings → External API; LAN/browser access is unchanged.
# While this variable is set, the enable/disable buttons are read-only
# (the flag is deployment-managed); reissuing the key stays allowed.
# SERVER_API_ENDPOINT_ENABLED=true

# Database
DATABASE_PATH=config/bragibooks.db

# m4b-merge
M4B_MERGE_BINARY=m4b-merge

# Audiobookdb API key (optional)
API_KEY_API_KEY=
API_KEY_BASE_URL=https://audiobookdb.org/api

# Directories
DIRECTORIES_INPUT_DIR=/input
DIRECTORIES_OUTPUT_DIR=/output
DIRECTORIES_COMPLETED_DIR=/input/done

# Processing
PROCESSING_NUM_CPUS=1
PROCESSING_PATH_FORMAT={author}/{title}
# Accepted for compatibility with older setups; has no effect on processing.
# PROCESSING_REGION=us
