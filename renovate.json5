{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["develop"],
  "schedule": ["before 6am on Monday"],
  "commitMessagePrefix": "chore(deps): ",
  "labels": ["dependencies", "ci", "renovate"],
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "dockerfile",
      "matchManagers": ["dockerfile"]
    },
    {
      "groupName": "docker-compose",
      "matchManagers": ["docker-compose"]
    },
    {
      // TypeScript 7 is the native (Go) compiler: the JS API no longer
      // exports the surface @sveltejs/kit 3.x and svelte-check need
      // (ts.readConfigFile, ts.sys), which breaks `svelte-kit sync` and
      // the vite build. Allow TS 6.x until the toolchain moves on.
      "matchPackageNames": ["typescript"],
      "allowedVersions": "< 7.0.0"
    }
  ]
}
