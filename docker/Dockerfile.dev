FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb

RUN apk add --no-cache git ffmpeg
RUN go install github.com/air-verse/air@v1.67.4

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Authoritative processing cutover: engine v2.2.0 (schema 1, supplied-mode
# {book_id}, plural people tokens), pinned by the immutable multi-arch index
# digest.
COPY --from=ghcr.io/djdembeck/m4b-merge:v2.2.0@sha256:ad08601cf802d93de4285ef0cb9056a0dcefbe063fc41272760a54899b4eeee2 /usr/local/bin/m4b-merge /usr/local/bin/m4b-merge

EXPOSE 8000

CMD ["air", "-c", ".air.toml"]