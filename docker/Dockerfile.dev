FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb

RUN apk add --no-cache git ffmpeg
RUN go install github.com/air-verse/air@v1.67.4

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

COPY --from=ghcr.io/djdembeck/m4b-merge:v2.0.1@sha256:4ab05f233ddd10f7f6d5a9f009998884921958ffd2997e1098268349a1a0bd0e /usr/local/bin/m4b-merge /usr/local/bin/m4b-merge

EXPOSE 8000

CMD ["air", "-c", ".air.toml"]