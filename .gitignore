.vscode
.DS_Store

.opencode
.sisyphus

# Environment files (keep committed templates)
.env
.env.*
!.env.example
!.env.test

# Impeccable: shared project artifacts (config.json, live/config.json,
# design.json, surfaces/*.md) stay tracked; per-run critique snapshots and
# ephemeral runtime output in the marked block below are ignored, mirroring
# the .gitignore in the pbakaus/impeccable repository.
# impeccable-ignore-start
.impeccable/live/server.json
.impeccable/live/codex-worker.json
.impeccable/live/codex-worker.log
# Ephemeral hook cache/state, at the project root and inside generated harness
# skill dirs; anchored patterns would miss the nested copies.
**/.impeccable/hook.cache.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/artifacts/
.impeccable/live/accept-receipts/
.impeccable/live/locks/
.impeccable/live/cache/
.impeccable/live/benchmarks/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/history/
# Per-developer overrides.
.impeccable/config.local.json
**/.impeccable/hook.pending.json
# Per-run critique snapshots are local artifacts; ignore.md carries deferrals
# worth sharing, so it is re-included.
.impeccable/critique/*
!.impeccable/critique/ignore.md
# impeccable-ignore-end
/bragibooks
/webfs/build/
# Python release artifacts (scripts/release.py builds archives into dist/;
# running it from the repo creates bytecode caches)
/dist/
__pycache__/
*.pyc
# Go runtime artifacts (databases, secrets)
.env
config/*.db
config/*.db-wal
config/*.db-shm
config/*.sqlite3*
config/secret_key.txt
config/config.yaml
# Playwright CLI debug artifacts
/.playwright-cli/
# Scratch build output
/tmp/
# Runtime databases under docker config
docker/config/*.db
docker/config/*.db-wal
docker/config/*.db-shm
# Local dev fixtures and runtime artifacts
/dev/
# Runtime databases and legacy backups under docker config
docker/config/
# Runtime book data under docker
docker/books/
